{
  "name": "csm-agent",
  "version": "0.2.0",
  "description": "Customer-centered CSM workbench with CRM-authoritative identities, ONES/Hemory evidence, renewal and expansion analysis, case publishing, and approved WeCom todo handoff.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "csm-agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "cli:smoke": "node dist/cli.js capabilities --json",
    "link:global": "npm run build && npm link",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run cli:smoke"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
