{
  "name": "csm-agent",
  "version": "0.1.0",
  "description": "CSM (Customer Success Manager) agent: reads CRM / ONES / call-recording systems over MCP, synthesizes follow-up records, customer profiles and case studies, and writes them back after human confirmation.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
