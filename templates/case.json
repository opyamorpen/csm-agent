{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "客户案例 Customer Case Study",
  "description": "每个成功案例一篇，五段客户叙事（背景→痛点→需求→解决方案→价值），经 CSM 审核后回写 ONES（默认 Wiki 页面组「案例库」）。",
  "type": "object",
  "required": ["customer_id", "customer_name", "background", "solution"],
  "properties": {
    "customer_id": { "type": "string", "description": "CRM 中客户唯一 ID" },
    "customer_name": { "type": "string", "description": "客户名称" },
    "background": { "type": "string", "description": "客户背景：行业、业务概况与合作起点的一段连贯叙述" },
    "challenges": {
      "type": "array",
      "items": { "type": "string" },
      "description": "痛点、现状与挑战"
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "需求与要求"
    },
    "solution": { "type": "string", "description": "解决方案：问题如何被分析、设计、实施与协同解决" },
    "value": {
      "type": "array",
      "items": { "type": "string" },
      "description": "价值与成效（量化优先，无量化写有据定性价值）"
    },
    "evidence_map": {
      "type": "object",
      "description": "内部字段：各章节证据依据说明，不进入客户版正文"
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "内部字段：CSM 需补充确认的关键信息，不进入客户版正文"
    }
  }
}
