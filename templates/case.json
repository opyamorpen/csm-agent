{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "客户案例 Customer Case Study",
  "description": "每个成功案例一篇，回写 ONES（默认 Wiki 页面组「案例库」）。",
  "type": "object",
  "required": ["customer_id", "customer_name", "background", "pain_points", "solution", "results"],
  "properties": {
    "customer_id": { "type": "string", "description": "CRM 中客户唯一 ID" },
    "customer_name": { "type": "string", "description": "客户名称" },
    "industry": { "type": "string", "description": "行业" },
    "background": { "type": "string", "description": "客户背景" },
    "pain_points": {
      "type": "array",
      "items": { "type": "string" },
      "description": "业务痛点"
    },
    "solution": { "type": "string", "description": "解决方案" },
    "implementation": { "type": "string", "description": "实施过程" },
    "results": {
      "type": "array",
      "description": "关键指标/收益",
      "items": {
        "type": "object",
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "customer_quote": { "type": "string", "description": "客户证言" },
    "reusable_lessons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "可复用经验/踩坑"
    }
  }
}
